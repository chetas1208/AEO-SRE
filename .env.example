# AEO SRE: environment. Copy to .env. Only the block below is required; nothing GitHub-related is needed.
ENVIRONMENT=development
# Production API: set ALLOW_TEST_RUN_MODE=false unless CI hits the same host.
ALLOW_TEST_RUN_MODE=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://aeo:aeo@localhost:5432/aeo
REDIS_URL=redis://localhost:6379/0

PROFOUND_API_KEY=
PROFOUND_BASE_URL=

# Mixpanel live behavioral events (read-only service account; never NUXT_PUBLIC_*)
MIXPANEL_ENABLED=true
MIXPANEL_PROJECT_ID=
MIXPANEL_API_HOST=
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_REGION=US
MIXPANEL_POLL_SECONDS=60
MIXPANEL_DEFAULT_ORG_ID=
MIXPANEL_ORG_DOMAIN=mixpanel.com

# Model runtime (provider-neutral; optional: without a key AEO SRE runs rules-only and the investigation is DEGRADED).
# One active provider. MODEL_API_PROTOCOL selects the wire format, MODEL_BASE_URL the server:
#   openai_chat       OpenAI, NVIDIA NIM (https://integrate.api.nvidia.com/v1), vLLM (http://host:8000/v1): /chat/completions
#   openai_responses  OpenAI-style /responses
#   anthropic_messages Anthropic native Messages (also NIM-style /v1/messages gateways)
# Verify with `make model-smoke` (one tiny request; the key is never printed).
MODEL_PROVIDER=anthropic
MODEL_API_PROTOCOL=anthropic_messages
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_FAST_NAME=claude-haiku-4-5
MODEL_DEEP_NAME=claude-sonnet-4-6
MODEL_DEFAULT_TIER=fast
MODEL_ESCALATION_ENABLED=true
# Optional tuning: MODEL_MAX_CONCURRENCY=4  MODEL_MAX_RETRIES=2  MODEL_CACHE_ENABLED=true
# Optional: MODEL_ALLOW_NO_KEY=true for self-hosted server without key.
# Optional per-task overrides (JSON): MODEL_TASK_OVERRIDES={"HYPOTHESIS_GENERATION":{"temperature":0.1,"timeout_s":90}}

# Frontend / URLs
# Canonical public backend (Cloudflare tunnel). Run scripts/sync-api-public-url.sh after starting the tunnel.
API_PUBLIC_URL=
BACKEND_BASE_URL=
# Browser: leave NUXT_PUBLIC_API_BASE_URL empty and set NUXT_PUBLIC_API_SAME_ORIGIN=1 to proxy /api → API_PUBLIC_URL (best: no CORS).
NUXT_BACKEND_PROXY_URL=
NUXT_PUBLIC_API_SAME_ORIGIN=1
NUXT_PUBLIC_API_BASE_URL=
APP_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=https://aeo-sre.vercel.app

# Hours to wait after a real execution (including a manual one) before post-intervention metrics are
# measured (Profound lags 24-48h)
VERIFICATION_DELAY_HOURS=48
AUTO_INVESTIGATE=true

# ---------------------------------------------------------------------------------------------------------
# OPTIONAL EXECUTORS. The default executor is Manual (always available, no configuration): AEO SRE prepares
# the exact change, a human applies it and records it. Uncomment ONLY if you want an operator to be able to
# select the GitHub PR executor for a given approval. It opens a PR (never merges); never used by default.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_BASE_BRANCH=main
# GITHUB_CONTENT_ROOT=
# GITHUB_CONTENT_EXTENSION=.md

# Change Guard: bearer token that external agents (e.g. a Profound Agent's Call API node) send as
# `Authorization: Bearer <token>` to POST /api/change-checks. Leave unset to keep the endpoint disabled (503).
# CHANGE_GUARD_TOKEN=

# Neo4j (graph database; OPTIONAL and PLANNED: infrastructure is in progress, see docs/GRAPH_SPEC.md. Postgres works without it.
# Never put these in NUXT_PUBLIC_* variables.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# NEO4J_ENABLED=            # unset -> on when NEO4J_URI and NEO4J_PASSWORD are set; false forces off
# NEO4J_GDS_ENABLED=false   # use GDS algorithms only if the plugin is also detected (plain AuraDB has none)
# NEO4J_AURA_API_CLIENT_ID=
# NEO4J_AURA_API_CLIENT_SECRET=

# Muse connector (docs/MUSE_CONNECTOR.md): bearer key Muse sends as `Authorization: Bearer <key>` to /muse/tools/*.
# Leave unset to keep the connector disabled (503). It is bound to ONE organization (id or domain).
MUSE_CONNECTOR_API_KEY=
MUSE_ORGANIZATION_ID=
MUSE_ORGANIZATION_DOMAIN=
MUSE_RATE_LIMIT_PER_MINUTE=60
# MUSE_ALLOW_SIMULATED=false   # true: honour X-Muse-Source-Mode: SIMULATED (tests/demos only)
# Muse Spark as the model provider (env only, key stays local):
# MODEL_PROVIDER=meta
# MODEL_API_PROTOCOL=openai_responses
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3
# MODEL_REASONING_HEADROOM=4096   # extra output tokens for reasoning (provider meta only)

# Control policy + Laya (docs/AGENTMATCH_DECISION_LAYER.md). Shadow mode records bandit/Laya alongside Change Guard.
# CONTROL_POLICY_MODE=SHADOW          # SHADOW | ACTIVE | BASELINE_ONLY
# CONTROL_POLICY_SHADOW_ENABLED=true
# LAYA_ENABLED=false                    # optional local checkpoint; when false/unloaded, decisions escalate per thresholds
# LAYA_CHECKPOINT=convaiinnovations/laya-typed-decisions
# LAYA_CONFIDENCE_ACCEPT=0.72
# LAYA_CONFIDENCE_REVIEW=0.55
# LAYA_CONFIDENCE_ESCALATE=0.40

# Auth + Muse OAuth (production: set APP_PUBLIC_URL to Vercel, API_PUBLIC_URL to stable Cloudflare host)
# APP_PUBLIC_URL=https://aeo-sre.vercel.app
# API_PUBLIC_URL=https://your-stable-api.example.com
# OAUTH_ISSUER=
# MUSE_OAUTH_CLIENT_ID=muse-agentmatch
# MUSE_OAUTH_REDIRECT_URIS=https://www.meta.ai/callback,http://127.0.0.1/callback
# MUSE_READ_RPM=120
# MUSE_WRITE_RPM=30
